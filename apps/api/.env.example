# Export these in your shell before starting Uvicorn.
CHECKPOINT_PATH=artifacts/checkpoints/best.pt
MODEL_DEVICE=auto
TORCH_NUM_THREADS=4
WEB_ORIGINS=http://localhost:3000
# Optional startup cameras. Use unique IDs; do not commit real credentials.
# Export this JSON string in your shell; camera configuration is process-local.
CAMERAS_JSON='[]'
# Example: export CAMERAS_JSON='[{"camera_id":"CCTV-01","url":"rtsp://192.168.1.20/stream","window_seconds":4,"sample_fps":4,"stride_seconds":1}]'
# For local testing use file:///absolute/path/to/video.mp4 (longer than the window).
# Run one Uvicorn worker. requirements.lock.txt includes the WebSocket transport.
